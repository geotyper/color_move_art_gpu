#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform coherent image2D gridVel; // xy velocity
layout(binding = 1, r16f)    uniform coherent image2D gridMass;

ivec2 wrapCoord(ivec2 p, ivec2 size)
{
    return ivec2((p.x % size.x + size.x) % size.x,
                 (p.y % size.y + size.y) % size.y);
}

// Simple viscosity-like smoothing: average neighbors weighted by mass, with self-bias.
void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gridVel);
    if (gid.x >= size.x || gid.y >= size.y)
        return;

    float mC = imageLoad(gridMass, gid).x + 1e-6;
    vec2 vC = imageLoad(gridVel, gid).xy;

    vec2 sumV = vC * mC;
    float sumM = mC;

    ivec2 offsets[4] = ivec2[](ivec2(1,0), ivec2(-1,0), ivec2(0,1), ivec2(0,-1));
    for (int i = 0; i < 4; ++i) {
        ivec2 p = wrapCoord(gid + offsets[i], size);
        float m = imageLoad(gridMass, p).x;
        vec2 v = imageLoad(gridVel, p).xy;
        sumV += v * m;
        sumM += m;
    }

    if (sumM > 1e-6) {
        vC = mix(vC, sumV / sumM, 0.35); // viscosity factor
    }

    imageStore(gridVel, gid, vec4(vC, 0.0, 0.0));
}
