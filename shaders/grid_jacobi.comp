#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r16f)    uniform coherent image2D pressureIn;
layout(binding = 1, r16f)    uniform coherent image2D divergence;
layout(binding = 2, r16f)    uniform coherent image2D pressureOut;

ivec2 wrapCoord(ivec2 p, ivec2 size)
{
    return ivec2((p.x % size.x + size.x) % size.x,
                 (p.y % size.y + size.y) % size.y);
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(pressureIn);
    if (gid.x >= size.x || gid.y >= size.y)
        return;

    float pL = imageLoad(pressureIn, wrapCoord(gid + ivec2(-1, 0), size)).x;
    float pR = imageLoad(pressureIn, wrapCoord(gid + ivec2(1, 0), size)).x;
    float pB = imageLoad(pressureIn, wrapCoord(gid + ivec2(0, -1), size)).x;
    float pT = imageLoad(pressureIn, wrapCoord(gid + ivec2(0, 1), size)).x;

    float div = imageLoad(divergence, gid).x;
    float p = (pL + pR + pB + pT - div) * 0.25;
    imageStore(pressureOut, gid, vec4(p));
}
