#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform coherent image2D gridVel;
layout(binding = 1, r16f)    uniform coherent image2D pressure;

ivec2 wrapCoord(ivec2 p, ivec2 size)
{
    return ivec2((p.x % size.x + size.x) % size.x,
                 (p.y % size.y + size.y) % size.y);
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gridVel);
    if (gid.x >= size.x || gid.y >= size.y)
        return;

    float pL = imageLoad(pressure, wrapCoord(gid + ivec2(-1, 0), size)).x;
    float pR = imageLoad(pressure, wrapCoord(gid + ivec2(1, 0), size)).x;
    float pB = imageLoad(pressure, wrapCoord(gid + ivec2(0, -1), size)).x;
    float pT = imageLoad(pressure, wrapCoord(gid + ivec2(0, 1), size)).x;

    vec2 v = imageLoad(gridVel, gid).xy;
    v.x -= (pR - pL) * 0.5;
    v.y -= (pT - pB) * 0.5;
    imageStore(gridVel, gid, vec4(v, 0.0, 0.0));
}
